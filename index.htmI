<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My AI Assistant</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #0b0f19;
      color: white;
      min-height: 100vh;
    }

    header {
      padding: 20px;
      text-align: center;
      border-bottom: 1px solid #242a38;
    }

    header h1 {
      font-size: 28px;
    }

    header p {
      color: #9ca3af;
      margin-top: 6px;
    }

    .container {
      max-width: 900px;
      margin: auto;
      padding: 25px 18px;
    }

    .hero {
      text-align: center;
      padding: 30px 10px;
    }

    .hero h2 {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .hero p {
      color: #aeb6c5;
      line-height: 1.6;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 15px;
      margin-top: 25px;
    }

    .card {
      background: #151b28;
      border: 1px solid #293244;
      border-radius: 16px;
      padding: 22px;
      transition: 0.2s;
    }

    .card:hover {
      transform: translateY(-3px);
      border-color: #667085;
    }

    .card h3 {
      margin-bottom: 8px;
    }

    .card p {
      color: #9ca3af;
      line-height: 1.5;
      font-size: 14px;
    }

    button {
      margin-top: 15px;
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 10px;
      background: #ffffff;
      color: #111827;
      font-weight: bold;
      cursor: pointer;
    }

    .chat {
      margin-top: 30px;
      background: #151b28;
      padding: 20px;
      border-radius: 16px;
      border: 1px solid #293244;
    }

    .chat input {
      width: 100%;
      padding: 13px;
      margin-top: 12px;
      border-radius: 10px;
      border: 1px solid #374151;
      background: #0b0f19;
      color: white;
      outline: none;
    }

    footer {
      text-align: center;
      color: #6b7280;
      padding: 30px;
      margin-top: 20px;
    }
  </style>
</head>

<body>

  <header>
    <h1>My AI Assistant</h1>
    <p>Your professional creative AI workspace</p>
  </header>

  <main class="container">

    <section class="hero">
      <h2>What do you want to create?</h2>
      <p>
        Create, edit and manage your creative projects from one place.
      </p>
    </section>

    <section class="features">

      <div class="card">
        <h3>🤖 AI Chat</h3>
        <p>Ask questions, generate ideas and work with your AI assistant.</p>
        <button onclick="openFeature('AI Chat')">Open</button>
      </div>

      <div class="card">
        <h3>🎨 2D Animation</h3>
        <p>Create professional 2D animation projects and scenes.</p>
        <button onclick="openFeature('2D Animation')">Open</button>
      </div>

      <div class="card">
        <h3>🎬 Video Editing</h3>
        <p>Edit videos, arrange scenes and prepare content for publishing.</p>
        <button onclick="openFeature('Video Editing')">Open</button>
      </div>

      <div class="card">
        <h3>🖼️ Image Tools</h3>
        <p>Create and edit images for your creative projects.</p>
        <button onclick="openFeature('Image Tools')">Open</button>
      </div>

      <div class="card">
        <h3>🎤 Voice</h3>
        <p>Use voice input and prepare voice-based content.</p>
        <button onclick="openFeature('Voice')">Open</button>
      </div>

      <div class="card">
        <h3>📁 Projects</h3>
        <p>Keep your creative projects organized in one workspace.</p>
        <button onclick="openFeature('Projects')">Open</button>
      </div>

    </section>

    <section class="chat">
      <h3>💬 Ask My AI</h3>
      <input
        id="message"
        type="text"
        placeholder="Type your message..."
        onkeydown="if(event.key === 'Enter') sendMessage()"
      >
      <button onclick="sendMessage()">Send</button>
      <p id="response" style="margin-top:15px;color:#9ca3af;"></p>
    </section>

  </main>

  <footer>
    My AI Assistant © 2026
  </footer>

  <script>
    function openFeature(feature) {
      alert(feature + " feature selected.");
    }

    function sendMessage() {
      const input = document.getElementById("message");
      const response = document.getElementById("response");

      if (input.value.trim() === "") {
        response.textContent = "Please type a message.";
        return;
      }

      response.textContent =
        "Your AI Assistant received: " + input.value;

      input.value = "";
    }
  </script>

</body>
</html>
